params {
    // Boilerplate options
    publish_dir_mode           = 'copy'
    email                      = null
    email_on_fail              = null
    plaintext_email            = false
    monochrome_logs            = false
    hook_url                   = null
    help                       = false
    version                    = false
    validate_params            = true
    show_hidden_params         = false
    schema_ignore_params       = false

    // Inputs: --alignment generates BEAST XMLs, --beast_dir postprocesses BEAST output (either or both)
    alignment = null
    beast_dir = null
    outdir = "output"
    run_name = new java.util.Date().format('yyyyMMdd')
    prefix = "bdbv_${params.run_name}"

    // BEAST XMLs: one XML per template given; set a template to false to skip it
    template_sg = "${projectDir}/templates/GTR_SG.template.xml"
    template_mat = null
    template_egc = "${projectDir}/templates/GTR_EGC.template.xml"
    template_lgc = null
    anchor_date = "2025-11-08"
    chain_length = 500000000
    log_every = 50000

    // Postprocessing
    burnin = 0.1
    resample = 1000
    treeannotator = "treeannotator"
    min_ess = 200
    force_low_ess = false

    wf {
          example_cmd = []
          agent = null
          container = "articnetworkorg/bdbv-pipeline-beast"
          // Until releases are tagged this tracks the latest image. At release time change this to
          // manifest.version so each release pins (and pulls) the image built for its own tag.
          container_version = "latest"
        }
}


manifest {
    name            = 'rmcolq/bdbv-pipeline-beast-nf'
    author          = 'Rachel Colquhoun'
    homePage        = 'https://github.com/rmcolq/bdbv-pipeline-beast-nf/'
    description     = 'BEAST XML generation and postprocessing for Bundibugyo ebolavirus (BDBV) phylodynamics, picking up from the final alignment of bdbv-pipeline.'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}

executor {
    $local {
        cpus = 8
        memory = "8 GB"
    }
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    container = "${params.wf.container}:${params.wf.container_version}"

    // Output layout: one subfolder of outdir per step
    publishDir = [path: { "${params.outdir}/${task.process.tokenize(':')[-1]}" }, mode: params.publish_dir_mode]
    withName: 'generate_xmls'     { publishDir = [path: "${params.outdir}/beast_xml", mode: params.publish_dir_mode] }
    withName: 'postprocess_logs'  { publishDir = [path: "${params.outdir}/postprocess_logs", mode: params.publish_dir_mode] }
    withName: 'postprocess_trees' { publishDir = [path: "${params.outdir}/postprocess_trees", mode: params.publish_dir_mode] }
}


profiles {
    // the "standard" profile is used implicitely by nextflow
    // if no other profile is given on the CLI
    standard {
        docker {
            enabled = true
            runOptions = "--user \$(id -u):\$(id -g) --group-add 100"
        }
    }

    // using singularity instead of docker
    singularity {
        singularity {
            enabled = true
            autoMounts = true
        }
    }

    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }

    // local profile for simplified development testing
    local {
        process.executor = 'local'
    }
}


timeline {
  enabled = true
  overwrite = true
  file = "${params.outdir}/execution/timeline.html"
}
report {
  enabled = true
  overwrite = true
  file = "${params.outdir}/execution/report.html"
}
trace {
  enabled = true
  overwrite = true
  file = "${params.outdir}/execution/trace.txt"
}

env {
	PYTHONNOUSERSITE = 1
}
